NODE_ENV=development
HOST=127.0.0.1
PORT=3000
CORS_ORIGINS=http://localhost:5173
SWAGGER_ENABLED=true

# Local development only. Keep DATABASE_URL consistent with POSTGRES_* below.
POSTGRES_USER=typstoria
POSTGRES_PASSWORD=typstoria_local
POSTGRES_DB=typstoria
POSTGRES_PORT=5432
DATABASE_URL=postgresql://typstoria:typstoria_local@127.0.0.1:5432/typstoria
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_QUERY_TIMEOUT_MS=5000
DATABASE_POOL_SIZE=10

# Browser app origin used in confirmation/reset links (no trailing slash).
PUBLIC_WEB_URL=http://localhost:5173
AUTH_ACCESS_TOKEN_TTL_SECONDS=604800
AUTH_VERIFY_TTL_SECONDS=86400
AUTH_RESET_TTL_SECONDS=900

# Optional: Google Identity Services Web application client ID. Empty disables Google sign-in.
# Client Secret is not used; the browser sends its Google ID token as JSON.
GOOGLE_CLIENT_ID=

# Mailjet is the only email provider, including local development.
# Required: real API credentials and a sender verified in Mailjet.
MAIL_FROM=
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
