NODE_ENV=development
HOST=127.0.0.1
PORT=3000
CORS_ORIGINS=http://localhost:5173
SWAGGER_ENABLED=true

# Local development only. Keep DATABASE_URL consistent with POSTGRES_* below.
POSTGRES_USER=typstoria
POSTGRES_PASSWORD=typstoria_local
POSTGRES_DB=typstoria
POSTGRES_PORT=5432
DATABASE_URL=postgresql://typstoria:typstoria_local@127.0.0.1:5432/typstoria
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_QUERY_TIMEOUT_MS=5000
DATABASE_POOL_SIZE=10

# Private immutable file storage on the host; never expose this directory through HTTP.
BLOB_STORAGE_PATH=.local/blobs

# Separate compile worker on the host; API can queue jobs while the worker is offline.
# The worker creates a fresh isolated Docker container for each compile attempt.
TYPST_RUNNER=docker
TYPST_DOCKER_BINARY_PATH=docker
TYPST_DOCKER_IMAGE=ghcr.io/typst/typst:0.14.2@sha256:b756590c0713ca5707654f3035e345c1d25dece2051817c11cc5591ae89992d4
# Used only with TYPST_RUNNER=linux (Bubblewrap + systemd user cgroups).
TYPST_BINARY_PATH=/usr/local/bin/typst
COMPILE_WORK_PATH=.local/compile

# Private per-project bare Git repositories and separate history worker.
GIT_STORAGE_PATH=.local/history
GIT_BINARY_PATH=/usr/bin/git

# Browser app origin used in confirmation/reset links (no trailing slash).
PUBLIC_WEB_URL=http://localhost:5173

# MCP uses http://127.0.0.1:PORT by default in development. Use a canonical HTTPS origin in production.
MCP_PUBLIC_ORIGIN=
# Enable MCP via OAuth with 32 random bytes encoded as base64url. Leave empty to disable MCP.
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
MCP_OAUTH_COOKIE_KEY=

AUTH_ACCESS_TOKEN_TTL_SECONDS=604800
AUTH_VERIFY_TTL_SECONDS=86400
AUTH_RESET_TTL_SECONDS=900

# Optional: Google Identity Services Web application client ID. Empty disables Google sign-in.
# Client Secret is not used; the browser sends its Google ID token as JSON.
GOOGLE_CLIENT_ID=

# Mailjet is the only email provider, including local development.
# Required: real API credentials and a sender verified in Mailjet.
MAIL_FROM=
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
