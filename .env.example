NODE_ENV=development
HOST=127.0.0.1
PORT=3000
CORS_ORIGINS=http://localhost:5173
SWAGGER_ENABLED=true

# Local development only. Keep DATABASE_URL consistent with POSTGRES_* below.
POSTGRES_USER=typstoria
POSTGRES_PASSWORD=typstoria_local
POSTGRES_DB=typstoria
POSTGRES_PORT=5432
DATABASE_URL=postgresql://typstoria:typstoria_local@127.0.0.1:5432/typstoria
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_QUERY_TIMEOUT_MS=5000
DATABASE_POOL_SIZE=10
